#!/usr/bin/env bash
# One-shot installer for Integral SoftCo WordPress on Debian 12/13.
#
# Stack: Caddy (HTTPS) → Docker PHP 7.4 + MySQL 8 → systemd helpers
#
# Usage (as root on the VPS, from the site root):
#   sudo ./install
#
# Optional overrides:
#   DOMAIN=integral.co.ke EMAIL=admin@integral.co.ke SKIP_DNS_CHECK=1 SKIP_FIREWALL=1

set -euo pipefail
set +H  # allow '!' in DB passwords when sourcing .env

DOMAIN="${DOMAIN:-integral.co.ke}"
ACME_EMAIL="${EMAIL:-admin@${DOMAIN}}"
SITE_ROOT="$(cd "$(dirname "$0")" && pwd)"
DEPLOY_DIR="${SITE_ROOT}/deploy"
COMPOSE_ENV="${DEPLOY_DIR}/.env"
DB_DUMP="${DB_DUMP:-${DEPLOY_DIR}/database.sql}"
LOG_TAG="[integral-install]"

red()  { printf '\033[1;31m%s\033[0m\n' "$*"; }
grn()  { printf '\033[1;32m%s\033[0m\n' "$*"; }
ylw()  { printf '\033[1;33m%s\033[0m\n' "$*"; }
inf()  { printf '%s %s\n' "$LOG_TAG" "$*"; }
die()  { red "$LOG_TAG ERROR: $*"; exit 1; }

need_root() {
  [[ "$(id -u)" -eq 0 ]] || die "Run as root: sudo ./install"
}

check_os() {
  [[ -f /etc/os-release ]] || die "Cannot detect OS"
  # shellcheck disable=SC1091
  source /etc/os-release
  [[ "${ID:-}" == "debian" ]] || die "This installer targets Debian (found: ${ID:-unknown})"
  if [[ "${VERSION_ID%%.*}" -lt 12 ]]; then
    ylw "Warning: tested on Debian 12/13; you have Debian ${VERSION_ID}"
  fi
  inf "OS: ${PRETTY_NAME}"
}

rand_pass() {
  python3 -c 'import secrets,string; print("".join(secrets.choice(string.ascii_letters+string.digits) for _ in range(24)))'
}

apt_base() {
  inf "Installing base packages…"
  export DEBIAN_FRONTEND=noninteractive
  apt-get update -qq
  apt-get install -y -qq \
    ca-certificates curl gnupg lsb-release apt-transport-https \
    debian-keyring debian-archive-keyring \
    python3 dnsutils ufw \
    >/dev/null
}

# Prefer working public DNS on the host (many VPS templates ship a broken resolver)
fix_host_dns() {
  if dig +short integral.co.ke A @1.1.1.1 2>/dev/null | grep -qE '^[0-9.]+$'; then
    if ! getent ahostsv4 "$DOMAIN" >/dev/null 2>&1; then
      inf "Fixing /etc/resolv.conf (1.1.1.1 / 8.8.8.8)…"
      printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' >/etc/resolv.conf
    fi
  fi
}

install_docker() {
  if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    inf "Docker already installed: $(docker --version)"
    systemctl enable --now docker >/dev/null 2>&1 || true
    return 0
  fi
  inf "Installing Docker Engine…"
  curl -fsSL https://get.docker.com | sh
  systemctl enable --now docker
  docker compose version >/dev/null || die "docker compose plugin missing after install"
}

install_caddy() {
  if command -v caddy >/dev/null 2>&1; then
    inf "Caddy already installed: $(caddy version 2>/dev/null | head -1)"
  else
    inf "Installing Caddy…"
    curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' \
      | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
    curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' \
      | tee /etc/apt/sources.list.d/caddy-stable.list >/dev/null
    chmod o+r /usr/share/keyrings/caddy-stable-archive-keyring.gpg \
      /etc/apt/sources.list.d/caddy-stable.list
    apt-get update -qq
    apt-get install -y -qq caddy >/dev/null
  fi
  mkdir -p /var/log/caddy
  chown -R caddy:caddy /var/log/caddy
  chmod 755 /var/log/caddy
}

check_dns() {
  [[ "${SKIP_DNS_CHECK:-0}" == "1" ]] && { ylw "Skipping DNS check"; return 0; }
  inf "Checking DNS for ${DOMAIN}…"
  local pub ip
  pub="$(curl -4 -fsS --max-time 8 https://ifconfig.me 2>/dev/null \
       || curl -4 -fsS --max-time 8 https://api.ipify.org 2>/dev/null || true)"
  ip="$(dig +short "$DOMAIN" A @1.1.1.1 2>/dev/null | awk '/^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/{print; exit}')"
  [[ -z "$ip" ]] && ip="$(dig +short "$DOMAIN" A @8.8.8.8 2>/dev/null | awk '/^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/{print; exit}')"
  [[ -z "$ip" ]] && ip="$(getent ahostsv4 "$DOMAIN" 2>/dev/null | awk '{print $1; exit}' || true)"
  if [[ -z "$ip" ]]; then
    ylw "DNS: ${DOMAIN} does not resolve yet — HTTPS cert may fail until A record points here."
    return 0
  fi
  if [[ -n "$pub" && "$ip" != "$pub" ]]; then
    ylw "DNS: ${DOMAIN} → ${ip}, this host → ${pub} (mismatch; certs may fail)"
  else
    grn "DNS OK: ${DOMAIN} → ${ip}"
  fi
}

write_compose_env() {
  if [[ -f "$COMPOSE_ENV" ]]; then
    inf "Reusing existing ${COMPOSE_ENV}"
    sed -i -E "s|^SITE_ROOT=.*|SITE_ROOT=${SITE_ROOT}|" "$COMPOSE_ENV"
    sed -i -E "s|^DOMAIN=.*|DOMAIN=${DOMAIN}|" "$COMPOSE_ENV"
    set -a
    # shellcheck disable=SC1090
    source "$COMPOSE_ENV"
    set +a
    return 0
  fi

  local db_name db_user db_pass db_root
  db_name="$(python3 - "${SITE_ROOT}/wp-config.php" <<'PY'
import re, sys
t = open(sys.argv[1], encoding="utf-8").read()
m = re.search(r"define\(\s*'DB_NAME'\s*,\s*'([^']*)'", t)
print(m.group(1) if m else "")
PY
)"
  db_user="$(python3 - "${SITE_ROOT}/wp-config.php" <<'PY'
import re, sys
t = open(sys.argv[1], encoding="utf-8").read()
m = re.search(r"define\(\s*'DB_USER'\s*,\s*'([^']*)'", t)
print(m.group(1) if m else "")
PY
)"
  db_pass="$(python3 - "${SITE_ROOT}/wp-config.php" <<'PY'
import re, sys
t = open(sys.argv[1], encoding="utf-8").read()
m = re.search(r"define\(\s*'DB_PASSWORD'\s*,\s*'([^']*)'", t)
print(m.group(1) if m else "")
PY
)"
  db_name="${db_name:-wjdvkrvg_data}"
  db_user="${db_user:-wjdvkrvg_data}"
  db_pass="${db_pass:-$(rand_pass)}"
  db_root="$(rand_pass)"

  cat >"$COMPOSE_ENV" <<EOF
# Generated by ./install — do not commit
SITE_ROOT=${SITE_ROOT}
DOMAIN=${DOMAIN}
DB_NAME=${db_name}
DB_USER=${db_user}
DB_PASSWORD=${db_pass}
DB_ROOT_PASSWORD=${db_root}
EOF
  chmod 600 "$COMPOSE_ENV"
  set -a
  # shellcheck disable=SC1090
  source "$COMPOSE_ENV"
  set +a
  inf "Wrote ${COMPOSE_ENV}"
}

patch_wp_config() {
  inf "Pointing WordPress at https://${DOMAIN}…"
  local cfg="${SITE_ROOT}/wp-config.php"
  [[ -f "$cfg" ]] || die "Missing wp-config.php"
  [[ -f "${cfg}.pre-install.bak" ]] || cp -a "$cfg" "${cfg}.pre-install.bak"

  DOMAIN="$DOMAIN" DB_NAME="$DB_NAME" DB_USER="$DB_USER" DB_PASSWORD="$DB_PASSWORD" \
  python3 - "$cfg" <<'PY'
import os, re, sys
path = sys.argv[1]
domain = os.environ["DOMAIN"]
db_name = os.environ["DB_NAME"]
db_user = os.environ["DB_USER"]
db_pass = os.environ["DB_PASSWORD"]
text = open(path, encoding="utf-8").read()

def repl_define(src, key, value):
    pat = re.compile(r"define\(\s*'%s'\s*,\s*'[^']*'\s*\)\s*;" % re.escape(key))
    rep = "define('%s', '%s');" % (key, value.replace("\\", "\\\\").replace("'", "\\'"))
    if pat.search(src):
        return pat.sub(rep, src, count=1)
    return src

text = repl_define(text, "WP_HOME", "https://" + domain)
text = repl_define(text, "WP_SITEURL", "https://" + domain)
text = repl_define(text, "DB_NAME", db_name)
text = repl_define(text, "DB_USER", db_user)
text = repl_define(text, "DB_PASSWORD", db_pass)

# Local-dev fallback used when INTEGRAL_WP_HOME is unset
text = re.sub(
    r"getenv\(\s*'INTEGRAL_WP_HOME'\s*\)\s*\?:\s*'https?://localhost:\d+'",
    "getenv( 'INTEGRAL_WP_HOME' ) ?: 'https://" + domain + "'",
    text,
    count=1,
)

if "WORDPRESS_DB_HOST" not in text:
    text = re.sub(
        r"define\(\s*'DB_HOST'\s*,\s*[^;]+;",
        "define('DB_HOST', getenv('WORDPRESS_DB_HOST') ?: '127.0.0.1:3306');",
        text,
        count=1,
    )

proxy_snip = """
/* Trust Caddy reverse proxy HTTPS */
if (isset($_SERVER['HTTP_X_FORWARDED_PROTO']) && $_SERVER['HTTP_X_FORWARDED_PROTO'] === 'https') {
	$_SERVER['HTTPS'] = 'on';
}
if (isset($_SERVER['HTTP_X_FORWARDED_HOST'])) {
	$_SERVER['HTTP_HOST'] = $_SERVER['HTTP_X_FORWARDED_HOST'];
}
"""
if "HTTP_X_FORWARDED_PROTO" not in text:
    marker = "/* That's all, stop editing"
    if marker in text:
        text = text.replace(marker, proxy_snip + "\n" + marker, 1)
    else:
        text = text.rstrip() + "\n" + proxy_snip + "\n"

open(path, "w", encoding="utf-8").write(text)
PY
}

fix_permissions() {
  inf "Fixing file permissions for Apache (www-data)…"
  # Readable tree; wp-content writable for uploads/cache
  chmod -R a+rX "$SITE_ROOT"
  chown -R www-data:www-data "${SITE_ROOT}/wp-content" || true
  # Keep secrets group-readable by www-data only
  if [[ -f "${SITE_ROOT}/wp-config.php" ]]; then
    chown root:www-data "${SITE_ROOT}/wp-config.php"
    chmod 640 "${SITE_ROOT}/wp-config.php"
  fi
  for f in .mail.env .sha-hie.env; do
    [[ -f "${SITE_ROOT}/${f}" ]] || continue
    chown root:www-data "${SITE_ROOT}/${f}"
    chmod 640 "${SITE_ROOT}/${f}"
  done
  chmod 755 "${SITE_ROOT}/install" 2>/dev/null || true
}

prepare_mail_env() {
  if [[ ! -f "${SITE_ROOT}/.mail.env" && -f "${SITE_ROOT}/.mail.env.example" ]]; then
    cp "${SITE_ROOT}/.mail.env.example" "${SITE_ROOT}/.mail.env"
    ylw "Created .mail.env from example — set INTEGRAL_SMTP_UPSTREAM_PASS before mail works."
  fi
  if [[ -f "${SITE_ROOT}/.mail.env" ]]; then
    sed -i -E 's|^INTEGRAL_SMTP_HOST=.*|INTEGRAL_SMTP_HOST=host.docker.internal|' "${SITE_ROOT}/.mail.env"
    sed -i -E 's|^INTEGRAL_SMTP_PORT=.*|INTEGRAL_SMTP_PORT=2525|' "${SITE_ROOT}/.mail.env"
  fi
  if [[ ! -f "${SITE_ROOT}/.sha-hie.env" && -f "${SITE_ROOT}/.sha-hie.env.example" ]]; then
    cp "${SITE_ROOT}/.sha-hie.env.example" "${SITE_ROOT}/.sha-hie.env"
    ylw "Created .sha-hie.env from example — fill HIE client credentials if needed."
  fi
}

start_stack() {
  inf "Building and starting Docker stack…"
  cd "$DEPLOY_DIR"
  docker compose --env-file "$COMPOSE_ENV" pull db >/dev/null || true
  docker compose --env-file "$COMPOSE_ENV" build --pull
  docker compose --env-file "$COMPOSE_ENV" up -d --remove-orphans

  inf "Waiting for MySQL…"
  local i=0
  until docker exec integral-mysql mysqladmin ping -h127.0.0.1 -uroot -p"${DB_ROOT_PASSWORD}" --silent 2>/dev/null; do
    i=$((i + 1))
    [[ $i -lt 60 ]] || die "MySQL did not become ready"
    sleep 2
  done
  grn "MySQL ready"
}

import_database() {
  if [[ ! -f "$DB_DUMP" ]]; then
    die "Missing database dump: ${DB_DUMP} (copy your dump there, then re-run ./install)"
  fi
  local sz
  sz="$(wc -c <"$DB_DUMP" | tr -d ' ')"
  if [[ "$sz" -lt 1000 ]]; then
    die "Database dump is empty/too small (${sz} bytes): ${DB_DUMP}"
  fi

  inf "Importing ${DB_DUMP} ($(numfmt --to=iec "$sz" 2>/dev/null || echo "${sz} bytes"))…"
  docker exec -i integral-mysql mysql -uroot -p"${DB_ROOT_PASSWORD}" <<SQL
DROP DATABASE IF EXISTS \`${DB_NAME}\`;
CREATE DATABASE \`${DB_NAME}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
CREATE USER IF NOT EXISTS '${DB_USER}'@'%' IDENTIFIED BY '${DB_PASSWORD}';
ALTER USER '${DB_USER}'@'%' IDENTIFIED BY '${DB_PASSWORD}';
GRANT ALL PRIVILEGES ON \`${DB_NAME}\`.* TO '${DB_USER}'@'%';
FLUSH PRIVILEGES;
SQL
  docker exec -i integral-mysql mysql -uroot -p"${DB_ROOT_PASSWORD}" "${DB_NAME}" <"$DB_DUMP"
  grn "Database imported"

  inf "Rewriting site URLs → https://${DOMAIN}"
  docker exec -i integral-mysql mysql -uroot -p"${DB_ROOT_PASSWORD}" "${DB_NAME}" <<SQL
UPDATE ddhj7u_options SET option_value = 'https://${DOMAIN}' WHERE option_name IN ('siteurl', 'home');
UPDATE ddhj7u_posts SET guid = REPLACE(guid, 'http://localhost:8080', 'https://${DOMAIN}');
UPDATE ddhj7u_posts SET post_content = REPLACE(post_content, 'http://localhost:8080', 'https://${DOMAIN}');
UPDATE ddhj7u_posts SET guid = REPLACE(guid, 'https://localhost:8080', 'https://${DOMAIN}');
UPDATE ddhj7u_posts SET post_content = REPLACE(post_content, 'https://localhost:8080', 'https://${DOMAIN}');
UPDATE ddhj7u_posts SET guid = REPLACE(guid, 'http://localhost:8081', 'https://${DOMAIN}');
UPDATE ddhj7u_posts SET post_content = REPLACE(post_content, 'http://localhost:8081', 'https://${DOMAIN}');
UPDATE ddhj7u_posts SET guid = REPLACE(guid, 'https://localhost:8081', 'https://${DOMAIN}');
UPDATE ddhj7u_posts SET post_content = REPLACE(post_content, 'https://localhost:8081', 'https://${DOMAIN}');
UPDATE ddhj7u_posts SET guid = REPLACE(guid, 'https://integral.co.ke', 'https://${DOMAIN}');
UPDATE ddhj7u_posts SET post_content = REPLACE(post_content, 'https://integral.co.ke', 'https://${DOMAIN}');
UPDATE ddhj7u_posts SET guid = REPLACE(guid, 'http://integral.co.ke', 'https://${DOMAIN}');
UPDATE ddhj7u_posts SET post_content = REPLACE(post_content, 'http://integral.co.ke', 'https://${DOMAIN}');
UPDATE ddhj7u_options SET option_value = REPLACE(option_value, 'http://localhost:8080', 'https://${DOMAIN}');
UPDATE ddhj7u_options SET option_value = REPLACE(option_value, 'https://localhost:8080', 'https://${DOMAIN}');
UPDATE ddhj7u_options SET option_value = REPLACE(option_value, 'http://localhost:8081', 'https://${DOMAIN}');
UPDATE ddhj7u_options SET option_value = REPLACE(option_value, 'https://localhost:8081', 'https://${DOMAIN}');
UPDATE ddhj7u_options SET option_value = REPLACE(option_value, 'https://integral.co.ke', 'https://${DOMAIN}');
UPDATE ddhj7u_options SET option_value = REPLACE(option_value, 'http://integral.co.ke', 'https://${DOMAIN}');
SQL
}

install_caddyfile() {
  inf "Configuring Caddy for ${DOMAIN}…"
  mkdir -p /etc/caddy /var/log/caddy
  chown -R caddy:caddy /var/log/caddy
  chmod 755 /var/log/caddy
  touch "/var/log/caddy/${DOMAIN}.access.log"
  chown caddy:caddy "/var/log/caddy/${DOMAIN}.access.log"

  # Free 80/443 if a leftover web server is running
  systemctl stop apache2 nginx 2>/dev/null || true
  systemctl disable apache2 nginx 2>/dev/null || true

  cat > /etc/caddy/Caddyfile <<EOF
# Generated by ./install — Integral SoftCo
{
	email ${ACME_EMAIL}
}

${DOMAIN}, www.${DOMAIN} {
	encode gzip zstd

	@www host www.${DOMAIN}
	redir @www https://${DOMAIN}{uri} permanent

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy 127.0.0.1:8080 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}

	log {
		output file /var/log/caddy/${DOMAIN}.access.log
		format console
	}
}
EOF

  caddy validate --config /etc/caddy/Caddyfile || die "Invalid Caddyfile"
  systemctl enable caddy
  systemctl restart caddy
  sleep 2
  systemctl is-active --quiet caddy || die "Caddy failed to start — check: journalctl -u caddy -n 50"
  grn "Caddy active"
}

install_systemd_units() {
  inf "Installing systemd units…"
  local unit dest
  for unit in facility-fhir-proxy.service smtp-relay.service integral-wp.service; do
    dest="/etc/systemd/system/${unit}"
    sed "s|__SITE_ROOT__|${SITE_ROOT}|g" "${DEPLOY_DIR}/systemd/${unit}" >"$dest"
  done

  touch "${SITE_ROOT}/.facility-fhir-proxy.log" "${SITE_ROOT}/.smtp-relay.log" \
    "${SITE_ROOT}/.facility-fr-cache.json"
  chown www-data:www-data \
    "${SITE_ROOT}/.facility-fhir-proxy.log" \
    "${SITE_ROOT}/.smtp-relay.log" \
    "${SITE_ROOT}/.facility-fr-cache.json" 2>/dev/null || true
  chown www-data:www-data \
    "${SITE_ROOT}/facility-fhir-proxy.py" \
    "${SITE_ROOT}/smtp-relay.py" 2>/dev/null || true

  systemctl daemon-reload
  systemctl enable --now facility-fhir-proxy.service
  systemctl enable integral-wp.service
  if [[ -f "${SITE_ROOT}/.mail.env" ]] && grep -q '^INTEGRAL_SMTP_UPSTREAM_HOST=' "${SITE_ROOT}/.mail.env"; then
    systemctl enable --now smtp-relay.service || ylw "SMTP relay not started (check .mail.env / logs)"
  else
    ylw "SMTP relay skipped — configure .mail.env then: systemctl enable --now smtp-relay"
  fi
}

configure_firewall() {
  [[ "${SKIP_FIREWALL:-0}" == "1" ]] && return 0
  command -v ufw >/dev/null 2>&1 || return 0
  inf "Configuring UFW (22/80/443)…"
  ufw allow OpenSSH >/dev/null 2>&1 || ufw allow 22/tcp >/dev/null 2>&1 || true
  ufw allow 80/tcp >/dev/null 2>&1 || true
  ufw allow 443/tcp >/dev/null 2>&1 || true
  if ! ufw status | grep -qi 'Status: active'; then
    ufw --force enable >/dev/null 2>&1 || true
  fi
}

fix_cron() {
  cat >/etc/cron.d/integral-wordpress <<EOF
*/5 * * * * www-data curl -fsS -o /dev/null https://${DOMAIN}/wp-cron.php?doing_wp_cron >/dev/null 2>&1 || true
EOF
  chmod 644 /etc/cron.d/integral-wordpress
}

smoke_check() {
  inf "Smoke checks…"
  local code ok=1
  code="$(curl -sS -o /dev/null --max-time 10 -w '%{http_code}' http://127.0.0.1:8080/ || true)"
  if [[ "$code" == "200" || "$code" == "301" || "$code" == "302" ]]; then
    grn "  local WordPress (:8080) → HTTP ${code}"
  else
    red "  local WordPress (:8080) → HTTP ${code:-fail}"
    ok=0
  fi
  if systemctl is-active --quiet caddy; then
    grn "  caddy OK"
  else
    red "  caddy not active"
    ok=0
  fi
  code="$(curl -sS -o /dev/null --max-time 15 -w '%{http_code}' "https://${DOMAIN}/" || true)"
  if [[ "$code" == "200" || "$code" == "301" || "$code" == "302" ]]; then
    grn "  https://${DOMAIN}/ → HTTP ${code}"
  else
    ylw "  https://${DOMAIN}/ → HTTP ${code:-fail} (cert/DNS may still be settling)"
  fi
  [[ $ok -eq 1 ]] || ylw "Some checks failed — see: docker logs integral-wordpress --tail 50"
}

print_summary() {
  cat <<EOF

$(grn "═══════════════════════════════════════════════════════════")
$(grn "  Integral SoftCo installed")
$(grn "═══════════════════════════════════════════════════════════")

  Site URL:     https://${DOMAIN}
  Login:        https://${DOMAIN}/wp-login.php
  Site root:    ${SITE_ROOT}

  Stack:
    Caddy        → systemctl status caddy
    WordPress    → docker compose -f ${DEPLOY_DIR}/docker-compose.yml ps
    FHIR proxy   → systemctl status facility-fhir-proxy
    SMTP relay   → systemctl status smtp-relay

EOF
}

main() {
  need_root
  check_os
  [[ -f "${SITE_ROOT}/wp-config.php" ]] || die "Run from the WordPress site root (wp-config.php missing)"
  [[ -d "$DEPLOY_DIR" ]] || die "Missing ${DEPLOY_DIR}"
  [[ -f "${DEPLOY_DIR}/Dockerfile" ]] || die "Missing ${DEPLOY_DIR}/Dockerfile"
  [[ -f "${DEPLOY_DIR}/docker-compose.yml" ]] || die "Missing ${DEPLOY_DIR}/docker-compose.yml"

  apt_base
  fix_host_dns
  install_docker
  install_caddy
  check_dns
  write_compose_env
  patch_wp_config
  prepare_mail_env
  fix_permissions
  start_stack
  import_database
  install_systemd_units
  install_caddyfile
  configure_firewall
  fix_cron
  # Re-apply perms after any writes
  fix_permissions
  smoke_check
  print_summary
}

main "$@"
