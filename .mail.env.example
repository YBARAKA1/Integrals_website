# Outbound SMTP for Contact Form 7 + demo inquiries.
# Copy to .mail.env and fill in.
#
# Local Docker (Mailhog):
#   INTEGRAL_SMTP_HOST=integral-mailhog
#   INTEGRAL_SMTP_PORT=1025
#
# Production (Integral mail via host relay — required inside Docker):
#   WordPress talks to smtp-relay.py on the host; the relay submits to mail.integral.co.ke.
#   Start with: ./start-local.sh   (or: python3 smtp-relay.py --port 2525)
#
#   INTEGRAL_SMTP_HOST=host.docker.internal
#   INTEGRAL_SMTP_PORT=2525
#   INTEGRAL_SMTP_UPSTREAM_HOST=mail.integral.co.ke
#   INTEGRAL_SMTP_UPSTREAM_PORT=465
#   INTEGRAL_SMTP_UPSTREAM_SECURE=ssl
#   INTEGRAL_SMTP_UPSTREAM_USER=no-reply@integral.co.ke
#   INTEGRAL_SMTP_UPSTREAM_PASS=********
#
# Note: port 587 is often blocked; 465/ssl works from this environment.

INTEGRAL_MAIL_TO=support@integral.co.ke
INTEGRAL_MAIL_CC=
INTEGRAL_SMTP_FROM=no-reply@integral.co.ke
INTEGRAL_SMTP_FROM_NAME=Integral Software
INTEGRAL_SMTP_HOST=host.docker.internal
INTEGRAL_SMTP_PORT=2525
INTEGRAL_SMTP_SECURE=
INTEGRAL_SMTP_USER=
INTEGRAL_SMTP_PASS=
INTEGRAL_SMTP_UPSTREAM_HOST=mail.integral.co.ke
INTEGRAL_SMTP_UPSTREAM_PORT=465
INTEGRAL_SMTP_UPSTREAM_SECURE=ssl
INTEGRAL_SMTP_UPSTREAM_USER=no-reply@integral.co.ke
INTEGRAL_SMTP_UPSTREAM_PASS=
